{
  "name": "bugarena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "check:meta": "node --env-file-if-exists=.env src/check-meta.js",
    "hunt": "node --env-file-if-exists=.env src/hunt.js",
    "smoke": "node src/hunt.js --fixture",
    "test": "node --test tests/*.test.js",
    "browser:install": "playwright install chromium",
    "replay": "playwright test --config playwright.config.js",
    "scenarios": "node src/coverage.js",
    "report:refresh": "node src/report.js",
    "dashboard": "node --env-file-if-exists=.env src/dashboard-server.js"
  },
  "dependencies": {
    "@playwright/test": "^1.56.0"
  }
}
